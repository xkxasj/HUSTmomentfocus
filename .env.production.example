# 复制为 .env.production 后逐项填写。.env.production 已被 .gitignore 忽略，
# 不要提交真实密钥。
#
# 生成随机密钥：
#   openssl rand -hex 32

# production 会触发启动自检：验证码回显、默认密钥、缺少 SMTP 都会让进程拒绝启动。
MOUKE_ENV=production
MOUKE_DOMAIN=mouke.example.com

# 同源部署时留空即可（浏览器不跨域）；若前端与 API 分域，写完整 origin。
MOUKE_ALLOWED_ORIGINS=

# 至少 32 位随机值。CODE_SECRET 用于验证码哈希，ALIAS_SECRET 用于匿名昵称，
# 两者分开，泄露一个不会同时暴露另一个。
MOUKE_CODE_SECRET=replace-with-32-byte-random-hex
MOUKE_ALIAS_SECRET=replace-with-another-32-byte-random-hex

# 学校邮箱 SMTP。以腾讯企业邮为例：465 + SSL。
MOUKE_SMTP_HOST=smtp.exmail.qq.com
MOUKE_SMTP_PORT=465
MOUKE_SMTP_SSL=1
MOUKE_SMTP_TLS=0
MOUKE_SMTP_USERNAME=noreply@example.com
MOUKE_SMTP_PASSWORD=replace-with-smtp-password
MOUKE_SMTP_FROM=某刻校园 <noreply@example.com>

# AI 能力可选；不配置时接口自动降级为模板文案，不会报错。
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# 首个管理员。首次启动时创建；之后改这里不会覆盖已存在账号。
MOUKE_ADMIN_STUDENT_ID=
MOUKE_ADMIN_EMAIL=
MOUKE_ADMIN_PASSWORD=

# 访问日志级别。生产用 INFO 输出一行一个 JSON；排查完可调回 WARNING。
MOUKE_LOG_LEVEL=INFO

# 数据目录由 compose 挂载，不要在 env 里改。
TZ=Asia/Shanghai

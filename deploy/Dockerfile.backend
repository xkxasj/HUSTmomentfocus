# 构建上下文是仓库根目录：docker build -f deploy/Dockerfile.backend .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    MOUKE_DB_PATH=/data/mouke.db \
    MOUKE_UPLOAD_DIR=/data/uploads \
    MOUKE_MAP_CACHE_DIR=/data/map_cache

WORKDIR /app

# python:slim 不保证带时区数据库。应用用 datetime.now() 存本地时间，
# 容器缺 tzdata 会悄悄跑在 UTC，前端再把无时区的 ISO 串当本地时间解析，
# 动态时间就会整体偏 8 小时。
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
COPY backend/scripts/retention.py ./scripts/retention.py
COPY deploy/backup.py ./backup.py

RUN mkdir -p /data/uploads /data/map_cache /data/backups

EXPOSE 8000

# 只开 1 个 worker：
# - 认证限流计数在进程内存里，多 worker 会各算各的；
# - SQLite 单写者，多 worker 只会增加锁竞争。
# 要横向扩容时先换 PostgreSQL + Redis，再增加 worker。
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]

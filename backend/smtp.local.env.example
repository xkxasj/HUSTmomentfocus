# Copy this file to smtp.local.env and fill in a dedicated sender mailbox.
# Never commit smtp.local.env or share its password in chat/screenshots.
# Outlook/Exchange Online requires OAuth2/Modern Auth. A normal Outlook password
# will not work with this password-based SMTP adapter; use a Graph/OAuth sender adapter.
MOUKE_SMTP_HOST=mail.hust.edu.cn
MOUKE_SMTP_PORT=465
MOUKE_SMTP_USERNAME=service-account@hust.edu.cn
MOUKE_SMTP_PASSWORD=replace-with-mailbox-password-or-app-password
MOUKE_SMTP_FROM=service-account@hust.edu.cn
MOUKE_SMTP_SSL=1
MOUKE_SMTP_TLS=0
MOUKE_DEV_EMAIL_CODES=0
MOUKE_CODE_SECRET=replace-with-a-long-random-secret

# Optional image-understanding adapter. It receives JSON with image_base64,
# mime_type, model and prompt, and must return JSON like {"caption":"..."}.
MOUKE_VISION_API_URL=
MOUKE_VISION_API_KEY=
MOUKE_VISION_MODEL=default
